{"model": "openai/gpt-6-luna", "qid": "code-001", "category": "coding", "trial": 2, "response": "```python\ndef run_length(s):\n    if not s:\n        return \"\"\n\n    result = []\n    count = 1\n\n    for i in range(1, len(s)):\n        if s[i] == s[i - 1]:\n            count += 1\n        else:\n            result.append(s[i - 1] + str(count))\n            count = 1\n\n    result.append(s[-1] + str(count))\n    return \"\".join(result)\n```", "latency_s": 1.44, "prompt_tokens": 110, "completion_tokens": 120, "cost_usd": 7.029e-05, "benchmark_version": "1.0", "timestamp": "2026-11-20T04:14:16Z"}
{"model": "openai/gpt-6-luna", "qid": "code-003", "category": "coding", "trial": 2, "response": "```python\ndef is_balanced(s):\n    pairs = {')': '(', ']': '[', '}': '{'}\n    stack = []\n\n    for char in s:\n        if char in '([{':\n            stack.append(char)\n        elif char in pairs:\n            if not stack or stack.pop() != pairs[char]:\n                return False\n\n    return not stack\n```", "latency_s": 1.652, "prompt_tokens": 114, "completion_tokens": 109, "cost_usd": 6.5241e-05, "benchmark_version": "1.0", "timestamp": "2026-11-20T04:14:16Z"}
{"model": "openai/gpt-6-luna", "qid": "code-005", "category": "coding", "trial": 2, "response": "```python\ndef merge_intervals(intervals):\n    if not intervals:\n        return []\n\n    sorted_intervals = sorted(intervals, key=lambda interval: interval[0])\n    merged = [[sorted_intervals[0][0], sorted_intervals[0][1]]]\n\n    for start, end in sorted_intervals[1:]:\n        if start <= merged[-1][1]:\n            merged[-1][1] = max(merged[-1][1], end)\n        else:\n            merged.append([start, end])\n\n    return merged\n```", "latency_s": 2.409, "prompt_tokens": 131, "completion_tokens": 179, "cost_usd": 0.000101574, "benchmark_version": "1.0", "timestamp": "2026-11-20T04:14:16Z"}
{"model": "openai/gpt-6-luna", "qid": "code-002", "category": "coding", "trial": 2, "response": "```python\ndef second_largest(nums):\n    largest = second = None\n    for num in nums:\n        if largest is None or num > largest:\n            second = largest\n            largest = num\n        elif num != largest and (second is None or num > second):\n            second = num\n    return second\n```", "latency_s": 2.41, "prompt_tokens": 99, "completion_tokens": 132, "cost_usd": 7.5141e-05, "benchmark_version": "1.0", "timestamp": "2026-11-20T04:14:16Z"}
{"model": "openai/gpt-6-luna", "qid": "code-006", "category": "coding", "trial": 2, "response": "```python\ndef charlie_cipher(s):\n    result = []\n    count = 0\n    for char in s:\n        if 'a' <= char <= 'z':\n            count += 1\n            result.append(chr((ord(char) - ord('a') + count) % 26 + ord('a')))\n        elif 'A' <= char <= 'Z':\n            count += 1\n            result.append(chr((ord(char) - ord('A') + count) % 26 + ord('A')))\n        else:\n            result.append(char)\n    return ''.join(result)\n```", "latency_s": 2.467, "prompt_tokens": 168, "completion_tokens": 163, "cost_usd": 9.7317e-05, "benchmark_version": "1.0", "timestamp": "2026-11-20T04:14:17Z"}
